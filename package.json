{
  "name": "light-launcher-plugin-f95",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "F95 Zone source plugin for Light Launcher.",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/main.ts --outfile bin/linux-x64/f95",
    "build:windows": "bun build --compile --target=bun-windows-x64 src/main.ts --outfile bin/windows-x64/f95.exe"
  },
  "dependencies": {
    "@light-launcher/plugin-sdk": "file:../light-launcher-plugin-sdk",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
