{
  "id": "f95",
  "name": "F95 Zone",
  "repository": "github:AzPepoze/light-launcher-plugin-f95",
  "version": "1.0.2",
  "apiVersion": "1",
  "minHost": "2.0.0",
  "entry": {
    "linux-x64": "bin/linux-x64/f95",
    "windows-x64": "bin/windows-x64/f95.exe"
  },
  "contributes": {
    "sources": [
      {
        "id": "f95",
        "label": "F95 Zone",
        "capabilities": ["browse", "browse:filters", "auth", "updateCheck", "resolveFiles", "sync:index"],
        "sidebar": [
          { "type": "search", "id": "text", "placeholder": "Search F95 titles" },
          { "type": "multi", "id": "engine", "label": "Engine", "dynamic": true, "searchable": true },
          {
            "type": "sort",
            "id": "sort",
            "options": [
              { "value": "latest", "label": "Last updated" },
              { "value": "title", "label": "Title" }
            ],
            "orderable": true,
            "default": { "value": "latest", "order": "desc" }
          }
        ]
      }
    ],
    "settings": { "$ref": "settings.schema.json" }
  },
  "permissions": {
    "network": [
      "f95zone.to",
      "*.f95zone.to",
      "pixeldrain.com",
      "mediafire.com",
      "*.mediafire.com",
      "workupload.com",
      "*.workupload.com",
      "datanodes.to",
      "*.datanodes.to",
      "krakenfiles.com",
      "*.krakenfiles.com",
      "buzzheavier.com",
      "*.buzzheavier.com",
      "bzzhr.to",
      "*.bzzhr.to",
      "mixdrop.co",
      "*.mixdrop.co",
      "mega.nz",
      "*.mega.co.nz"
    ],
    "fs": ["$GAMES"],
    "secrets": true,
    "browser": true,
    "exec": false
  }
}
