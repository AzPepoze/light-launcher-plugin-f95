{
  "id": "f95",
  "name": "F95 Zone",
  "repository": "github:AzPepoze/light-launcher-plugin-f95",
  "version": "1.0.0",
  "apiVersion": "1",
  "minHost": "2.0.0",
  "entry": {
    "linux-x64": "bin/linux-x64/f95",
    "windows-x64": "bin/windows-x64/f95.exe"
  },
  "contributes": {
    "sources": [
      {
        "id": "f95",
        "label": "F95 Zone",
        "capabilities": ["browse", "auth", "updateCheck", "resolveFiles", "sync:index"]
      }
    ],
    "settings": { "$ref": "settings.schema.json" }
  },
  "permissions": {
    "network": [
      "f95zone.to",
      "*.f95zone.to",
      "pixeldrain.com",
      "mediafire.com",
      "*.mediafire.com",
      "workupload.com",
      "*.workupload.com",
      "datanodes.to",
      "*.datanodes.to",
      "krakenfiles.com",
      "*.krakenfiles.com",
      "buzzheavier.com",
      "*.buzzheavier.com",
      "bzzhr.to",
      "*.bzzhr.to",
      "mixdrop.co",
      "*.mixdrop.co",
      "mega.nz",
      "*.mega.co.nz"
    ],
    "fs": [],
    "secrets": true,
    "browser": true,
    "exec": false
  }
}
